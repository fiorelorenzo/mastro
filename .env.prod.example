# Production secrets and configuration (#76). Copy to .env.prod, fill it
# in, then restrict its permissions: `chmod 600 .env.prod`. Never committed
# (.gitignore: `.env.*`, `!.env.example`) and never read by the Dockerfile,
# only by compose at container start (`docker compose -f compose.prod.yaml
# --env-file .env.prod up -d`). See docs/deploy.md for the full runbook and
# docs/self-hosting.md for where each credential below comes from.

# Postgres. DATABASE_URL is not set here: compose.prod.yaml composes it
# from these three so the password exists in exactly one place.
POSTGRES_USER=mastro
POSTGRES_PASSWORD=
POSTGRES_DB=mastro

# Better Auth (see AGENTS.md). Generate with `openssl rand -base64 32`.
# Losing this invalidates every session, so it belongs in the backup set
# alongside the database and the documents directory (docs/backup.md).
BETTER_AUTH_SECRET=
# The public URL this instance is reachable at, i.e. `https://` plus
# MASTRO_SITE_ADDRESS below. Used to build the Google OAuth callback URL
# and to set the Secure flag on session cookies.
BETTER_AUTH_URL=https://ledger.example.com

# Google OAuth client (console.cloud.google.com > APIs & Services >
# Credentials). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated addresses allowed to sign in. Empty or unset admits
# nobody, not everybody: this is the difference between single tenant and
# single user (AGENTS.md, invariant 6).
AUTH_ALLOWED_EMAILS=

# Where the app stores archived approval documents (invariant 4: every
# derived datum keeps its source document) and the pack registry data
# files, bind-mounted into the container. Point this at a real path with
# durable storage in production, e.g. /var/lib/mastro/documents; it is part
# of the backup set (docs/backup.md).
DOCUMENTS_DIR=/var/lib/mastro/documents
# The blob store's own ceiling, in bytes (#306): independent of every
# caller — `storeDocument` refuses anything over this on its own, so the
# invariant holds even if a future caller forgets to check the size
# first. 50 MiB by default when unset.
DOCUMENT_MAX_BYTES=52428800

# Your own tax id, in the form it appears on an invoice (e.g. IT01234567890).
# Folder import needs it to tell an outgoing invoice from an incoming one,
# and refuses to guess: importing with this unset throws rather than file
# a supplier's bill as your own revenue.
ACCOUNT_HOLDER_TAX_ID=

# The public origin, exactly as a browser sees it. adapter-node compares
# this against the Origin header on every form POST, and rejects the
# request with 403 when they disagree. Behind a TLS-terminating proxy the
# app only ever sees plain HTTP, so without this every form in the product
# fails: recording a day, creating a client, marking an invoice paid. It
# is the same value as BETTER_AUTH_URL and there is no sane default, so
# set it.
ORIGIN=https://ledger.example.com

# The app's own published port, loopback-only (#76: never 0.0.0.0, the
# reverse proxy is the only thing allowed to face the network).
WEB_PORT=3001

# Mail (#72, #84): SMTP/IMAP with an app password, never the Gmail API —
# see docs/self-hosting.md section 4 for why. Sending goes over SMTP; the
# same credentials append the sent message to the user's own Sent folder
# over IMAP. Leaving every SMTP_*/IMAP_* variable unset is a supported
# configuration: mail sending and mailbox polling are both optional, and
# `/api/mail/poll` (below) just has nothing to poll.
SMTP_HOST=
SMTP_PORT=587
# 'true' for implicit TLS (port 465); 'false' (STARTTLS on port 587,
# negotiated automatically) for the more common case.
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# The OAuth client the Google API features (Gmail sending below, the Drive
# mirror further down) refresh their token with (#348). Unset, they use
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above, which is right when the same
# client also obtained the token — the documented consent flow does exactly
# that. Set it only when the refresh token was issued by a *different*
# client: a refresh token cannot be spent by a client that did not obtain it
# (Google answers 401 unauthorized_client), so reusing a token another tool
# already holds means naming its client here.
#
# If you do that, note what you are accepting: that token's grant is
# whatever the other tool asked for, which is likely wider than the
# `gmail.send` and `drive.file` this application spends. Nothing here can
# widen a grant — no feature names a scope, by construction — so behaviour
# is unchanged; what changes is how much a leak of this file would be worth.
# The alternative is a narrow two-scope consent of your own, see
# docs/self-hosting.md section 4.
GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=

# Sending over the Gmail API instead of SMTP (#345). Only worth setting on
# a host that cannot reach an SMTP port: this box is one, every submission
# port is refused outbound (#339). `gmail.send` is sensitive, not
# restricted, so no security assessment — but the Cloud project must be
# published or its refresh tokens expire after 7 days. Reuses
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET; see docs/self-hosting.md section 4.
GMAIL_SEND_REFRESH_TOKEN=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_SENT_MAILBOX=Sent
# Ceiling on one inbound message's RFC822 size, in bytes (#306). Checked
# against the IMAP listing's own `size` before the message is ever
# fetched, so anything over this is never buffered whole; it is still
# recorded (envelope, not-archived, reason), visible on
# /mail/contracts/[id], so a human can fetch it by hand if it matters.
# 25 MiB by default (Gmail's own inbound cap) when unset.
IMAP_MAX_MESSAGE_BYTES=26214400

# Scheduling (#222): the `scheduler` compose service calls
# `/api/mail/poll`, `/api/agent/run` and `/api/alerts/run/{push,digest}`
# on its own — see docs/deploy.md, "Scheduling". Each route checks its own
# bearer token before doing anything (`$lib/server/auth/cron-token.ts`,
# #304), so an unset token here does not just leave the job unscheduled,
# it also leaves the route itself refusing every caller — a bare 401,
# indistinguishable from a wrong token, so a caller cannot fingerprint
# which cron variables this instance has configured. Generate both with
# `openssl rand -base64 32`. Leaving IMAP_POLL_CRON_TOKEN unset is fine
# if IMAP is not configured above; ALERT_CRON_TOKEN also gates the
# agent-run route (see that route's own comment for why it reuses this
# token), so leaving it unset stops mail extraction being queued too,
# not only alert delivery.
IMAP_POLL_CRON_TOKEN=
ALERT_CRON_TOKEN=
# How often the scheduler calls each route, in minutes. Optional —
# scripts/scheduler.ts's own defaults (5 minutes for polling/draining, 15
# for the push job, a week for the digest) are reasonable for most
# instances; override only to change the cadence.
# MAIL_POLL_INTERVAL_MINUTES=5
# AGENT_RUN_INTERVAL_MINUTES=5
# ALERT_PUSH_INTERVAL_MINUTES=15
# ALERT_DIGEST_INTERVAL_MINUTES=10080

# Web Push (#63), delivered by the alert push job above. Generate a pair
# with `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a `mailto:`
# address or `https:` URL identifying this instance to a push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The reverse proxy. MASTRO_SITE_ADDRESS is your real domain, already
# pointed at this host; MASTRO_TLS_ARG is the email address Caddy registers
# its ACME account under, so it can email you about certificate problems.
# PROXY_HTTP_PORT/PROXY_HTTPS_PORT are the host ports 80/443 must be free
# on this host for the ACME challenge and the plain-HTTP redirect to work.
#
# For a local rehearsal instead of a real deployment, use:
#   MASTRO_SITE_ADDRESS=localhost
#   MASTRO_TLS_ARG=internal
#   PROXY_HTTP_PORT=8080
#   PROXY_HTTPS_PORT=8443
# which makes Caddy mint a self-signed certificate from its own local CA
# instead of requesting one from Let's Encrypt, and avoids needing ports 80
# and 443 free on a shared box.
MASTRO_SITE_ADDRESS=ledger.example.com
MASTRO_TLS_ARG=you@example.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# The ACP runner (#82). See docs/agent-runner.md for the full picture.
# Leaving RUNNER_AGENT_COMMAND unset is a supported configuration — the
# rest of the stack works unaffected, and the runner service just has
# nothing to do (see compose.prod.yaml's own comment on the service).
#
# Rotated into the mastro_runner role (drizzle/0035_acp_runner_role.sql)
# by scripts/migrate.ts on every boot. Generate with `openssl rand -base64
# 32`, and avoid characters a connection-string URL would need escaping —
# hex (`openssl rand -hex 32`) is simpler to embed correctly in
# RUNNER_DATABASE_URL below, which compose.prod.yaml composes for you.
RUNNER_DB_PASSWORD=

# A CLI command that speaks ACP (agentclientprotocol.com). There is one
# agent path, not two: #195 removed the per-contract consent gate, because
# with Claude as the only model the gate chose between extraction and
# manual entry rather than between two models, and on a one-person
# instance the only person who could set the flag was the only person it
# constrained.
#
# RUNNER_AGENT_ARGS is a JSON array of strings; RUNNER_AGENT_ENV is a JSON
# object of environment variables for that subprocess only — never this
# container's own environment, so RUNNER_DATABASE_URL can never reach a
# spawned model agent.
RUNNER_AGENT_COMMAND=
RUNNER_AGENT_ARGS=
RUNNER_AGENT_ENV=

# How long one ACP prompt turn may run before the runner gives up on it,
# in milliseconds. Optional, defaults to 120000 (two minutes) when
# unset; compose.prod.yaml passes this through to the runner service by
# name.
# RUNNER_MODEL_TIMEOUT_MS=120000
