# Copy to .env for local development. Never commit .env.

# The compose project every `pnpm db:*` script drives. compose.yaml names
# it `mastro`, which is right for a single checkout and wrong for several:
# a git worktree gets its own POSTGRES_PORT here but not its own container,
# so a `pnpm db:up` from one checkout recreates the one container every
# other checkout is using, and they all share the single `pgdata` volume
# and therefore the same database. Set this to something per checkout
# (`mastro-<worktree>`) and each gets its own container, volume and port.
# A value here overrides compose.yaml's `name:`; only `-p` and a shell
# variable of the same name beat it.
COMPOSE_PROJECT_NAME=mastro

# The dev and preview server's port. Per checkout for the same reason
# POSTGRES_PORT is, and strict: a port already in use is an error rather
# than a quiet move to the next one. Note this does not separate session
# cookies between two checkouts, since cookies ignore the port entirely
# (see AGENTS.md, "A per-checkout port does not give you a per-checkout
# session").
WEB_PORT=5187

# Local Postgres, as started by compose.yaml.
POSTGRES_USER=mastro
POSTGRES_PASSWORD=mastro
POSTGRES_DB=mastro
POSTGRES_PORT=5436

# Everything that talks to the database reads this one variable.
DATABASE_URL=postgres://mastro:mastro@localhost:5436/mastro

# Where the content-addressed document store (#49) writes blobs.
# Read directly from process.env, not through $env/dynamic/private, since
# that module snapshots values at server start. Defaults to
# ./data/documents when unset.
DOCUMENT_STORAGE_ROOT=./data/documents
# The blob store's own ceiling, in bytes (#306): independent of every
# caller — `storeDocument` refuses anything over this on its own, so the
# invariant holds even if a future caller forgets to check the size
# first. 50 MiB by default when unset.
DOCUMENT_MAX_BYTES=52428800

# Better Auth (see AGENTS.md). Generate a secret with
# `openssl rand -base64 32`. Losing it invalidates every session, so it
# belongs in the backup set alongside the database.
BETTER_AUTH_SECRET=
# Public URL this instance is reachable at. Used to build the Google OAuth
# callback URL and to decide whether session cookies get the Secure flag.
BETTER_AUTH_URL=http://localhost:5187

# Google OAuth client (console.cloud.google.com > APIs & Services >
# Credentials). Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated addresses allowed to sign in. Checked before the account
# is created, so an address outside this list is rejected even though it
# completed Google's side. Empty or unset admits nobody: this is the
# difference between single tenant and single user.
AUTH_ALLOWED_EMAILS=

# The account holder's own tax id (#45): direction detection compares
# every imported invoice's supplier tax id against this value. An invoice
# whose supplier does not match is incoming and is skipped rather than
# counted as revenue. For a FatturaPA-issuing consultant this is the
# `IdPaese` + `IdCodice` of their own VAT registration, e.g. IT01234567890.
ACCOUNT_HOLDER_TAX_ID=

# Mail: IMAP/SMTP with an app password (#72). Reading is always IMAP —
# reading over the Gmail API needs a restricted scope, and doing IMAP over
# OAuth needs `https://mail.google.com/`, which Google's own restricted list
# defines as "includes any usage of IMAP, SMTP, and POP3": a CASA assessment
# and an annual re-certification, for every self-hoster. An app password
# needs no Google Cloud project at all. For Gmail: enable 2-Step
# Verification, then generate one at myaccount.google.com/apppasswords.
#
# Sending is the one half where an API is cheaper than the protocol, and
# GMAIL_SEND_REFRESH_TOKEN below is how you pick it. Unset, sending goes
# over SMTP and the sent message is appended to Sent over IMAP, which is
# what every non-Gmail provider needs.
SMTP_HOST=
SMTP_PORT=587
# 'true' for implicit TLS (port 465); 'false' (with STARTTLS negotiated
# automatically) for the more common port 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
# The address and display name a sent message shows as "From". Usually
# the same address as SMTP_USER/IMAP_USER.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Sending over the Gmail API instead of SMTP (#345). Optional, and only
# worth it on a host that cannot reach an SMTP port at all — many VPS
# providers block outbound 587/465 as anti-spam policy, and no amount of
# configuration changes that (#339). Set, this sends over HTTPS with the
# `gmail.send` scope — sensitive, not restricted, so brand verification
# and no security assessment — and skips the Sent append, because Gmail
# files its own API sends into Sent and dedupes by Message-ID.
#
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above, like the Drive
# mirror does: one Cloud project, one consent screen. The refresh token is
# obtained once by a human, see docs/self-hosting.md section 4. Note the
# publishing-status difference from `drive.file`: `gmail.send` IS
# sensitive, so the project must be published, or its refresh tokens
# expire after 7 days.
GMAIL_SEND_REFRESH_TOKEN=

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_APP_PASSWORD=
# Name of the Sent mailbox to append to. Left unset, the SPECIAL-USE
# extension (RFC 6154) is tried first if the server reports one; this is
# the fallback for a server that does not. Gmail's own IMAP name for it
# is "[Gmail]/Sent Mail".
IMAP_SENT_MAILBOX=Sent

# IMAP inbound polling (#84): pulls new mail per contract's configured
# folder/label (set from /mail/contracts/[id]) and hands each thread off
# as a document + inbound_thread row. `pnpm dev` schedules nothing
# itself; in production the `scheduler` compose service calls
# `/api/mail/poll` on an interval (docs/deploy.md, "Scheduling",
# `MAIL_POLL_INTERVAL_MINUTES`).
#
# Shared secret the scheduler presents to POST /api/mail/poll. Generate
# one with `openssl rand -base64 32`.
IMAP_POLL_CRON_TOKEN=

# Ceiling on one inbound message's RFC822 size, in bytes (#306). Checked
# against the IMAP listing's own `size` before the message is ever
# fetched, so anything over this is never buffered whole; it is still
# recorded (envelope, not-archived, reason), visible on
# /mail/contracts/[id], so a human can fetch it by hand if it matters.
# 25 MiB by default (Gmail's own inbound cap) when unset.
IMAP_MAX_MESSAGE_BYTES=26214400

# The document mirror (#50): a one-way copy of every document into
# either a local directory or Google Drive. Optional — unset, both are a
# supported "no mirror" configuration, silently. Configure at most one.
#
# A local directory (a synced folder, an rclone/Syncthing mount, ...):
DRIVE_MIRROR_LOCAL_ROOT=
# Google Drive, `drive.file` scope only (AGENTS.md). Reuses
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above; the refresh token itself
# is obtained once by a human, see docs/self-hosting.md section 4 — this
# project has no way to obtain or verify one itself.
DRIVE_MIRROR_REFRESH_TOKEN=
# The top-level folder name client-scoped documents publish under.
# Defaults to "Contracts".
DRIVE_MIRROR_CONTRACTS_FOLDER=

# The alert engine (#74, #75, #63). `pnpm dev` schedules nothing itself;
# in production the `scheduler` compose service calls
# /api/alerts/run/push and /api/alerts/run/digest on their own intervals
# (docs/deploy.md, "Scheduling", `ALERT_PUSH_INTERVAL_MINUTES`/
# `ALERT_DIGEST_INTERVAL_MINUTES`).
#
# Shared secret the scheduler presents to POST /api/alerts/run/push and
# /api/alerts/run/digest. Generate one with `openssl rand -base64 32`.
ALERT_CRON_TOKEN=
# Web Push (#63). Generate a pair with `npx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: address or https: URL identifying this
# instance to a push service, per RFC 8292.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The ACP runner (#82): a separate process, its own database role, its own
# credentials — see docs/agent-runner.md for the full picture. Unset by
# default: the runner is optional infrastructure, and the rest of the
# product is fully usable without it (invariant 3's other half — a runner
# failure degrades to manual entry, it never breaks the ledger).
#
# Rotated into the mastro_runner role (migration 0035) by scripts/migrate.ts
# on every run. Generate with `openssl rand -base64 32`.
RUNNER_DB_PASSWORD=
# Same host and database as DATABASE_URL, a different role and password —
# mastro_runner can read two columns of contract and all of document, and
# cannot write anywhere at all (0035_acp_runner_role.sql). Never point this
# at the same role DATABASE_URL uses.
RUNNER_DATABASE_URL=postgres://mastro_runner:changeme@localhost:5436/mastro
# Where the runner's durable, crash-safe job queue lives on disk (never in
# the database — see docs/agent-runner.md for why). Defaults to
# ./data/runner-queue when unset.
RUNNER_QUEUE_DIR=./data/runner-queue

# The model, talked to over ACP (agentclientprotocol.com) as a CLI
# subprocess. RUNNER_AGENT_ARGS is a JSON array of strings and
# RUNNER_AGENT_ENV a JSON object of extra environment variables for that
# subprocess only — never its parent's full environment, so
# RUNNER_DATABASE_URL and every other secret this process holds never
# reaches the spawned model agent.
#
# Unset is a supported state, not a gap: with no command configured the
# runner fails loudly with a configuration error rather than fabricating a
# proposal. Claude Code speaks ACP through Zed's adapter, which is the
# command below; the token is a long-lived one from `claude setup-token`,
# and it is the only credential the spawned agent receives.
#
#   RUNNER_AGENT_COMMAND=npx
#   RUNNER_AGENT_ARGS=["-y","@zed-industries/claude-code-acp"]
#   RUNNER_AGENT_ENV={"CLAUDE_CODE_OAUTH_TOKEN":"...","PATH":"/usr/local/bin:/usr/bin:/bin","HOME":"/home/mastro"}
RUNNER_AGENT_COMMAND=
RUNNER_AGENT_ARGS=
RUNNER_AGENT_ENV=
